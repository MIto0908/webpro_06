<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>駅番号</td><td><%= data.code %></td></tr>
    <tr><td>駅名</td><td><%= data.name %></td></tr>
    <tr><td>乗り換え路線</td><td><%= data.change %></td></tr>
    <tr><td>1日乗降人員</td><td><%= data.passengers %>人</td></tr>
    <tr><td>布施駅からの距離</td><td><%= data.distance %>km</td></tr>
  </table>
  <a href="/keiyo2">駅一覧に戻る</a>
</body>
</html>
